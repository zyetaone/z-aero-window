[Unit]
Description=Aero Window App Server (SvelteKit + Fleet hub)
Documentation=https://github.com/zyetaone/z-aero-window
After=network-online.target
Wants=network-online.target

# Bound any restart loop. Restart=always with no limit turns a permanent
# failure — port already bound, bad EnvironmentFile, missing interpreter —
# into an invisible 10s heartbeat that never resolves and never reports.
# With these, systemd gives up after 5 starts in 5 minutes and parks the unit
# in `failed`, where `systemctl status` says so.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__AERO_USER__
# The APP directory, not the install/git root. Since the repo split into
# aero-1/ and aero-2/ with shared assets at the top, the git root has no
# package.json — so `bun run serve` from there fails instantly, and under
# Restart=always that is a permanent 10s crash loop with a dark kiosk.
# install.sh resolves this placeholder by finding the package.json.
WorkingDirectory=__AERO_APP_DIR__

EnvironmentFile=-/etc/aero/config.env
Environment=NODE_ENV=production
Environment=HOME=/home/__AERO_USER__
Environment=PORT=3000

# Serve-only — the unit must NEVER build. Building here meant a bad commit
# put the Pi in a build-fail → Restart=always crash loop with a dark kiosk.
# Builds happen exactly twice: install.sh (initial) and aero-updater.sh
# (updates, with rollback + health probe). If build/ is missing, v1's
# server.ts serves a 503 instead of crashing — degraded, not looping.
#
# NOTE: that last sentence is true of v1 ONLY. aero-2/server.ts deliberately
# exits 1 on a missing build, on the argument that a 503 keeps the unit green
# while the kiosk shows an error page, so nothing ever restarts and nothing
# ever reports. Both positions are defensible; they need different units.
# When WorkingDirectory is repointed at aero-2, add:
#     ConditionPathExists=__AERO_APP_DIR__/build/index.js
# so systemd skips a start it knows will fail — a clean "Condition check
# failed" line rather than a crash entry. Not added now, because on v1 it
# would override the degrade-don't-crash behaviour this comment describes.
#
# This used to say "see the migration plan, Phase 4". There is no migration
# plan. The nearest document, ADR-004, is a renderer migration INSIDE aero-1
# and does not mention aero-2. The cutover gates are listed in
# docs/AERO-1-VS-AERO-2.md section 9; the first of them is a frame measured
# on a real Pi 5, which has never been run.
ExecStart=__BUN_BIN__ run serve

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Resource limits — app should never monopolise the Pi.
LimitNOFILE=65536
# Graceful shutdown — SvelteKit adapter-node handles SIGTERM within 10s.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
