[Unit]
Description=Aero Window OTA Updater (git pull + rebuild + verify, with rollback)
Documentation=https://github.com/zyetaone/z-aero-window
After=network-online.target aero-app.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs the repo's OWN copy of the updater — a git pull refreshes it in place,
# so there's no stale-installed-copy problem (the provision-pi scheme needs a
# self-refresh step; this one doesn't). Runs as root: it must systemctl
# restart the app + kiosk units. The script sets git safe.directory for the
# kiosk-owned repo.
EnvironmentFile=-/etc/aero/config.env
# systemd hands a unit a near-empty environment, and git aborts with
# "fatal: $HOME not set" before doing any work — so every timer fire failed
# silently and the fleet never updated. Must be set explicitly.
Environment=HOME=/root
ExecStart=/bin/bash __AERO_INSTALL_DIR__/deploy/aero-updater.sh
StandardOutput=journal
StandardError=journal
# A stuck update (e.g. a hung build) must not run forever.
#
# This has to cover the wall-wide apply hold, not just the build. The updater
# sleeps until the quarter-hour boundary every pane computes from the release
# commit's committer time, and that boundary is 1200..2099 s after the commit;
# a pane that fetches the instant the commit lands starts this unit with the
# full 2099 s ahead of it, and the build runs inside that window rather than
# before it. So 600 s killed 91.3% of updates mid-sleep — after `git reset
# --hard` and `bun run build`, before restart_services, which left the pane
# serving old code over a new build that the next timer fire would then skip
# because the tree already matched origin. A silent, permanent mixed wall.
#
# 3600 s = AERO_APPLY_BUDGET_SEC (2700) + ~15 min of build/install headroom.
# The script clamps the hold to that budget and takes the straggler branch if
# the boundary is further out, so raising this without the clamp would only
# raise the ceiling on the hold. Keep the two in step.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
