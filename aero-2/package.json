{
	"name": "aero-2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "AERO_ADMIN_UI=1 vite dev",
		"build": "bun run --bun build:bun",
		"build:bun": "vite build",
		"preview": "vite preview",
		"serve": "bun run server.ts",
		"start": "bun run build && bun run server.ts",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node tools/check-repo.mjs && node tools/check-route-exports.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node tools/check-repo.mjs && vitest run && node tools/check-route-exports.mjs",
		"test:watch": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"smoke": "node tools/smoke-routes.mjs"
	},
	"dependencies": {
		"@svelte-maplibre-gl/pmtiles": "^2.0.1",
		"maplibre-gl": "^6.11.2",
		"svelte-maplibre-gl": "^2.2.1",
		"three": "^0.185.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "1.0.0-next.5",
		"@sveltejs/kit": "3.0.0-next.30",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/three": "^0.185.4",
		"happy-dom": "^20.14.5",
		"jsqr": "^1.4.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^4.1.11"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
