# Client tile base URL, inlined at build time. Default: /api/tiles
# Declared with a schema in src/env.ts, which strips any trailing slash.
# Point it at a peer to let one Pi on the wall serve the archive for all three.
# PUBLIC_TILE_SERVER_URL=/api/tiles

# Local tile archive (server-side). Default resolution order, first hit wins:
#   1. TILE_DIR
#   2. /opt/zyeta-aero/tiles   (the Pi install path)
#   3. ./data/tiles
#   4. ../data/tiles
#
# NOT under static/ — that hands ~56k files to Vite's static copy, doubling
# them into build/ and serving them outside the /api/tiles guard. See the note
# on resolveTileDir in src/lib/server/tiles.ts.
# TILE_DIR=data/tiles

# Proxy missing tiles from GIBS / terrarium. Only on when NODE_ENV=development
# or this is explicitly 1; fails closed on an unset NODE_ENV so the Pi never
# silently reaches the internet.
# AERO_TILE_REMOTE_FALLBACK=0

# Extra origins the video/slideshow/audio modes may load media from.
# Space-separated, BUILD-TIME (the CSP is emitted into the HTML shell, so
# changing this needs a rebuild, not a restart).
#
# Empty by default and that is the intended fielded setup: serve media off the
# Pi, under /api or static/, and the wall keeps working when the WiFi does not.
# AERO_MEDIA_ORIGINS="https://cdn.example.com https://media.example.org"

# --- Server ---
# Listen port (server.ts). The Pi unit sets 3000; `bun run dev` uses 5173.
# PORT=3000

# --- Operator surfaces (fail closed) ---
# /admin is a 404 unless this is exactly 1. It renders hostname, LAN addresses
# and a remote control for the wall with no auth in front of it, so it is an
# explicit opt-in, not the absence of NODE_ENV=production. `bun run dev` sets it.
# AERO_ADMIN_UI=1

# --- Bearer tokens (all fail closed: unset means the route answers 503) ---
# Media upload / USB import (POST /api/media, /api/media/import-usb).
# AERO_ADMIN_TOKEN=
# WiFi reset endpoint (POST /api/wifi/reset).
# AERO_WIFI_RESET_TOKEN=
# Telemetry heartbeat (POST /api/fleet/heartbeat). install.sh generates one per device.
# AERO_FLEET_TOKEN=

# --- Content on the Pi ---
# Where uploaded media is stored. Default: ./data/media
# AERO_MEDIA_DIR=
# Upload size cap in MB (media-store.ts). Unset = the built-in default.
# AERO_MEDIA_MAX_MB=
# Read-only mount the USB import walks. Default: /media/aero
# AERO_USB_DIR=
# Wall snapshot file (GET/POST /api/wall). Default: ./data/wall.json
# AERO_WALL_PATH=
# Thermal state file the kiosk's watchdog writes; read by /api/internal/thermal.
# AERO_THERMAL_STATE_PATH=

