{
  "name": "aero-3",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/earcut": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@babylonjs/addons": "9.29.0",
    "@babylonjs/core": "9.29.0",
    "@babylonjs/loaders": "9.29.0",
    "earcut": "^3.2.4"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "compile": "bun build --compile --minify --target=bun-linux-arm64 server.ts --outfile dist/aero-3",
    "smoke": "bun tools/smoke.ts",
    "build": "bun tools/build.ts",
    "serve": "NODE_ENV=production bun build/index.js",
    "coverage": "bun test --coverage"
  },
  "imports": {
    "#*": "./src/*"
  }
}
