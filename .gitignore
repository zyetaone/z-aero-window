node_modules

# Output
.output
.vercel
.netlify
.wrangler
# Unanchored, because there is no longer a single app at the repo root: v1
# lives in aero-1/ and the rewrite in aero-2/, each with its own generated
# .svelte-kit/ and build/. The leading-slash forms matched ONLY the root, so
# the moment v1 moved, 8000+ generated files became stageable — and `git add
# -A` duly staged them.
.svelte-kit/
build/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Build output
dist/

# Cesium static assets (copied from node_modules during setup)
static/cesium/

# Project management symlink (sidecar, not part of repo)
_project

# Claude Code session state — worktrees + agent memory are local only
.claude/

# Tile packages (downloaded, not source)
tile-packager/*.lock
tile-server/*.lock

# Runtime content (pushed bundles + uploaded assets)
# `data/*`, NOT `data/` — git does not descend into an excluded DIRECTORY, so a
# nested `!data/roads/` under a bare `data/` never re-includes anything. That
# was invisible for data/buildings only because those files were already
# tracked when the exception was written, and gitignore does not apply to
# tracked files. Excluding the ENTRIES instead lets the negations below work.
data/*
# ...EXCEPT the OSM vector extracts. See docs note below.
#
# data/ is packager OUTPUT and rightly ignored — 189 MB of raster tiles from
# CARTO / EOX / Esri, none of which we are licensed to redistribute, so caching
# them in the repo would be a WORSE licence position than streaming them.
#
# data/buildings is different on both counts. It is ~1.3 MB of OSM footprints
# under ODbL — free to redistribute with attribution, which /wiki already
# carries — and it is the ONLY source for the offline buildings tier
# (world/buildings-geojson). Ignoring it made that tier structurally
# undeliverable: install.sh points TILE_DIR at ${INSTALL_DIR}/data, inside the
# git checkout, and git pull IS the deploy mechanism — so an ignored path is one
# the fleet can never receive. Tracking it means the tier ships with the code.
#
# data/roads is tracked for the same two reasons, as of the CARTO removal.
# It is ~48 MB of ODbL road centrelines (per-class radii; arterials to 40 km),
# and it is now the ONLY source for the night street grid (world/roads-geojson)
# — the CartoDB raster it replaced was 132 MB of the tile cache and
# Enterprise-only for commercial use. Still rides `git pull` to the fleet.
!data/buildings/
!data/roads/
# data/towns is tracked for the same two reasons: ~2.3 MB of lamp points
# thresholded offline from the NASA VIIRS Black Marble (open data), and the
# ONLY source for the distant-town night tier (world/towns-lamps) — an
# ignored path rides no `git pull` to the fleet.
!data/towns/

# ⚠ `data/*` above is ROOT-ANCHORED — a pattern with an internal slash is —
# while the bare `data/` it replaced matched at ANY depth. This path silently
# stopped being covered and 18k packager tiles turned up untracked. Re-stated.
#
# Re-stated a SECOND time when v1 moved into aero-1/, which changed this path
# again and re-armed the identical trap: `git add -A` staged 6000 CARTO raster
# tiles we are not licensed to redistribute. Listing every depth by hand is
# what keeps failing, so match the packager's output directory wherever it
# sits, and keep the old path for anyone with a stale working tree.
**/tile-packager/data/
tools/tile-packager/data/

# graphify knowledge-graph output (regenerable)
graphify-out/
src/graphify-out/

# Local agent tooling state (not project source)
.context/
.serena/
.codex/
outputs/
