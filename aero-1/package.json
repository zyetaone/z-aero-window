{
  "name": "aero-dynamicwindow",
  "private": true,
  "version": "0.9.0-beta",
  "description": "Zyeta Aero Dynamic Window — circadian airplane-window kiosk. Engineered by rdtect.",
  "author": "rdtect for Zyeta",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "postinstall": "chmod +x node_modules/.bin/* 2>/dev/null || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node tools/check-cycles.mjs && node tools/check-cesium-isolation.mjs && node tools/check-determinism.mjs && node tools/check-rune-naming.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node tools/check-cycles.mjs && node tools/check-cesium-isolation.mjs && node tools/check-determinism.mjs && node tools/check-rune-naming.mjs && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "generate-textures": "bun run scripts/generate-textures.ts",
    "prefetch-tiles": "bun run scripts/prefetch-tiles.ts",
    "build-pmtiles": "bun run scripts/build-pmtiles.ts",
    "process-clouds": "bun run scripts/process-clouds.ts",
    "serve": "bun run server.ts",
    "start": "bun run build && bun run server.ts",
    "smoke": "node tools/smoke-routes.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "@google/genai": "^1.52.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/multicast-dns": "^7.2.4",
    "@vitest/ui": "^4.1.10",
    "bun-types": "^1.3.14",
    "chrome-remote-interface": "^0.34.0",
    "happy-dom": "^20.11.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@threlte/core": "^8.5.16",
    "@threlte/extras": "^9.21.0",
    "cesium": "^1.143.0",
    "multicast-dns": "^7.2.5",
    "three": "^0.183.2"
  }
}
