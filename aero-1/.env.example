# Aero 1 — environment variables.
# Copy to `.env` and fill in what this install needs. Every key below is read
# somewhere under `src/` or `server.ts`; nothing here is aspirational.

# --- 3D tiles & globe ---
# Cesium Ion token for terrain/imagery at DEV time. Fielded Pis use the local
# tile cache (TILE_DIR) and ship without one. Build-time only for terrain pack.
VITE_CESIUM_ION_TOKEN=
# Same token, server side (tile-packager downloads Ion terrain at build time).
CESIUM_ION_TOKEN=
# Offline tile cache dir. Default on Pi: /opt/zyeta-aero/tiles
TILE_DIR=
# MapBox token for the Cesium mapbox imagery path (cesium-setup.ts).
VITE_MAPBOX_TOKEN=
# Tile base URL override served to the client (LAN peer tile sharing).
VITE_TILE_SERVER_URL=

# --- Auth (all fail closed: unset means the route answers 503) ---
# Bearer for admin routes.
AERO_ADMIN_TOKEN=
# Bearer for the WiFi reset endpoint.
AERO_WIFI_RESET_TOKEN=
# Lower-privilege bearer for the telemetry heartbeat. Auto-generated per device
# by install.sh; set explicitly to share one value fleet-wide.
AERO_FLEET_TOKEN=

# --- Content bundles & assets ---
AERO_BUNDLES_DIR=
AERO_ASSETS_DIR=
AERO_LAN_CACHE_DIR=

# --- Fleet identity & behaviour ---
AERO_DEVICE_ID=
# Set to 1 to disable the LAN proxy (server.ts).
AERO_DISABLE_LAN_PROXY=
# Set to 1 for per-heartbeat server logging.
AERO_HEARTBEAT_LOG=
# Where the thermal watchdog keeps state (thermal endpoint).
AERO_THERMAL_STATE_PATH=

# --- Runtime ---
PORT=
